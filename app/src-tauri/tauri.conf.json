{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veloxify",
  "version": "0.1.0",
  "identifier": "gg.veloxify.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Veloxify",
        "width": 1500,
        "height": 950,
        "minWidth": 1000,
        "minHeight": 650,
        "center": true,
        "visible": false,
        "backgroundColor": "#0f0f0f"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
